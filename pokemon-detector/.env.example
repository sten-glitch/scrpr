# Local eBay application keys. Never paste them into chat or commit this file.
# App ID (Client ID) -> CLIENT_ID; Cert ID (Client Secret) -> CLIENT_SECRET.
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_ENVIRONMENT=sandbox
# Dedicated callback; set real values only in ignored .env or secret manager.
EBAY_DELETION_ENDPOINT=
EBAY_DELETION_VERIFICATION_TOKEN=
# Hours eBay listing data is kept (default 6, API License 8.1(c)); max 720.
BIGSTEN_EBAY_RETENTION_HOURS=6
